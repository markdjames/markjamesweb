{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "markjamesweb-dev",
  "main": "worker/index.ts",
  "compatibility_date": "2026-07-27",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "send_email": [
    { "name": "EMAIL", "remote": true }
  ],
  "observability": {
    "enabled": true
  }
}
